# Optional local configuration. Copy to .env; never commit real credentials.
# All paths below are relative to the repository root.
DATABASE_URL=sqlite:///./branch_learning.db

# Optional first-run OpenAI-compatible model. Leaving the key empty creates no model.
# You can add OpenAI-compatible or Anthropic models in Settings instead.
DEFAULT_LABEL=My model
DEFAULT_BASE_URL=https://api.openai.com/v1
DEFAULT_LLM_MODEL=your-model-id
DEFAULT_API_KEY=

# Optional: without this key, web search uses DDGS.
TAVILY_API_KEY=
