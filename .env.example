# Optional local configuration. Copy to .env; never commit real credentials.
# All paths below are relative to the repository root.
DATABASE_URL=sqlite:///./branch_learning.db

# Built-in learning-memory retrieval: hybrid (default) or lexical.
# Basic setup uses keywords; optional hybrid adds local E5-small + BGE-reranker-v2-m3.
# Install with: uv run python scripts/manage.py retrieval (no extra API key).
# Pinned weights need approximately 2.55 GiB, plus tokenizers and Python dependencies.
# Basic setup never downloads weights. Optional preparation caches them under
# .runtime/retrieval/models/. Normal startup only loads cached weights; missing
# components or models fall back to keywords. Choose lexical to disable semantics.
# manage.py dev/check/e2e always use lexical mode in their isolated environment.
MEMORY_RETRIEVAL_MODE=hybrid

# Optional first-run OpenAI-compatible model. Leaving the key empty creates no model.
# You can add OpenAI-compatible or Anthropic models in Settings instead.
DEFAULT_LABEL=My model
DEFAULT_BASE_URL=https://api.openai.com/v1
DEFAULT_LLM_MODEL=your-model-id
DEFAULT_API_KEY=

# Context window and answer reserve are per-model settings, not .env options.
# Configure them in Settings -> Models -> Advanced. Defaults are 32768 / 4096.
# Use the provider's actual supported window; local budgets use a character-class
# token estimator, not exact provider token counts. Compaction needs no model download.
# Older history is compacted once it exceeds this share of the input budget (0.1-1.0);
# the hard budget still bounds every request.
CONTEXT_COMPACTION_RATIO=0.6
# Compacted history uses cached model summaries; "background" prepares the missing ones after
# each answer for later questions, so no answer waits, "inline" asks for one before the answer.
# CONTEXT_SUMMARY_BLOCKS caps the summary calls after each answer (1-8). The model marked
# "Use this model for context summaries" in Settings -> Models -> Advanced writes them.
CONTEXT_SUMMARY_MODE=background
CONTEXT_SUMMARY_BLOCKS=1

# Agent tool loop budgets, checked between tool rounds (a running call is never cut off).
# After this many seconds, or once the tool results gathered for one answer reach this many
# estimated tokens, the model answers from what it has without further tools.
AGENT_TIME_LIMIT_SECONDS=180
AGENT_TOOL_TOKEN_BUDGET=60000

# Requests from other devices or host names (not this computer) must carry the phone-access
# cookie handed out by Settings -> Phone access. "off" disables that check; keep "required".
ACCESS_TOKEN_MODE=required
# Where that token is kept (relative to the repository root); the Docker image uses
# /data/phone-access-token in its volume.
ACCESS_TOKEN_FILE=.runtime/phone-access-token

# Your own learning styles, one Markdown file each (see docs/learning-presets.md), relative to
# the repository root; the Docker image uses /data/learning-presets in its volume.
LEARNING_PRESETS_DIR=learning-presets

# Optional: without this key, web search uses DDGS.
TAVILY_API_KEY=
